# Copy this file to .env for local development.
# Never put real secrets in this example file or commit your .env file.

# The inbox that receives contact-form submissions.
CONTACT_DESTINATION_EMAIL="your-inbox@example.com"

# Must use a sender address on a domain onboarded to Cloudflare Email Service.
CONTACT_FROM_EMAIL="contact@algoways.co.il"

# Create a Turnstile widget in Cloudflare and copy its public site key here.
TURNSTILE_SITE_KEY="replace-with-turnstile-site-key"

# Keep this value secret. Store it as an encrypted secret in production.
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"
